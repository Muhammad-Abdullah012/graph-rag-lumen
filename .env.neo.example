# Neo4j container configuration
# Copy to .env.neo and update values

# Authentication: format is username/password
NEO4J_AUTH=neo4j/your_secure_password

# Disable strict config validation (required for Community Edition)
NEO4J_server_config_strict__validation_enabled=false

# Advertised address — set to your server's hostname or IP
# Used by clients to connect; for local use set to localhost
NEO4J_server_default__advertised__address=localhost
NEO4J_server_bolt_advertised__address=localhost:7687
NEO4J_server_bolt_tls__level=DISABLED
